# Leave GEMINI_API_KEY blank to run in MOCK mode (simulated strip readings, rules-based advice).

# --- Google Gemini (free key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Comma-separated models tried in order if the primary one is missing, overloaded or out of free quota
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest,gemini-2.5-flash-lite,gemini-3.5-flash
# AI runs in the background, so calls may take a while without blocking anyone (seconds)
# GEMINI_TIMEOUT=60
# GEMINI_TOTAL_BUDGET=150

# auto = mock only when the key is missing | mock = force mock
JALPARAKH_MODE=auto

# Pads read with less confidence than this are "uncertain" -> verdict "retake" (never "safe")
CONFIDENCE_THRESHOLD=0.6

# India Post pincode lookup (free, no key). off = offline prefix table only
PINCODE_LOOKUP=on

# Protects POST /api/admin/import (restore the impact log after a redeploy). Leave empty to disable.
ADMIN_TOKEN=

# Max tests per client per 10 minutes (in memory only)
RATE_LIMIT=30

# Storage (defaults to ./data)
# DATABASE_PATH=./data/jalparakh.db
